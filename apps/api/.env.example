# Copy to .env (gitignored). Mirrors infra/docker/docker-compose.yml values for local Postgres.
DATABASE_URL="postgresql://jobhunt:jobhunt_dev_password@localhost:5434/jobhunt?schema=public"

PORT=3001
WEB_APP_URL="http://localhost:3000"

# Clerk (get these from https://dashboard.clerk.com — Developers > API Keys)
CLERK_SECRET_KEY=""

# Anthropic (get from https://console.anthropic.com). Leave empty to use the
# built-in mock AI extraction instead of calling the real API.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5"
