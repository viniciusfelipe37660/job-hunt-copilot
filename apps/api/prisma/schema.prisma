generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum ApplicationStatus {
  SAVED
  APPLIED
  INTERVIEW
  OFFER
  REJECTED
}

// Mirrors Clerk's user — we do NOT store passwords/auth, just a profile keyed by Clerk's userId (sub claim)
model User {
  id             String   @id @default(uuid())
  clerkUserId    String   @unique
  email          String   @unique
  name           String?
  baseResumeText String?  @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  applications   Application[]
  resumeVersions ResumeVersion[]
  reminders      FollowUpReminder[]
}

model ResumeVersion {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label     String
  content   String   @db.Text
  isBase    Boolean  @default(false)
  createdAt DateTime @default(now())

  applications Application[]

  @@index([userId])
}

model Application {
  id             String            @id @default(uuid())
  userId         String
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  company        String
  role           String
  jobUrl         String?
  jobDescription String?           @db.Text

  status         ApplicationStatus @default(SAVED)
  boardPosition  Int               @default(0)

  appliedAt      DateTime?
  interviewAt    DateTime?
  offerAt        DateTime?
  rejectedAt     DateTime?
  lastActivityAt DateTime          @default(now())

  notes          String?           @db.Text

  resumeVersionId String?
  resumeVersion   ResumeVersion?   @relation(fields: [resumeVersionId], references: [id], onDelete: SetNull)

  skillTags      SkillTagOnApplication[]
  reminders      FollowUpReminder[]
  aiSuggestion   AiSuggestion?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId, status])
}

// Normalized skill/keyword tags extracted by the AI step — powers analytics
// ("response rate by skill") without re-parsing JD text every time.
model SkillTag {
  id   String @id @default(uuid())
  name String @unique

  applications SkillTagOnApplication[]
}

model SkillTagOnApplication {
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  skillTagId    String
  skillTag      SkillTag    @relation(fields: [skillTagId], references: [id], onDelete: Cascade)
  relevance     Float?

  @@id([applicationId, skillTagId])
}

// Stores the AI-generated output for an application. One-to-one with Application for simplicity.
model AiSuggestion {
  id                 String      @id @default(uuid())
  applicationId      String      @unique
  application        Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  extractedSkills    Json
  requirements       Json
  resumeBullets      Json
  coverLetterSnippet String?     @db.Text

  modelUsed          String
  createdAt          DateTime    @default(now())
}

model FollowUpReminder {
  id            String      @id @default(uuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  dueAt      DateTime
  message    String
  dismissed  Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([userId, dueAt, dismissed])
}
